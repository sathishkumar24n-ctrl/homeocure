# Supabase public/client configuration
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Server-only Supabase configuration
# Never expose this in client code or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp / Meta Cloud API server-only configuration
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_TEMPLATE_NAME=your-approved-template-name
WHATSAPP_DEFAULT_COUNTRY_CODE=91
